# The two production origins, baked in at build time.
#
# They cannot be derived at runtime: the studio and the partner shop are deliberately
# hosted by different providers, which is the whole point of the cross-origin tool
# exchange. config/origins.js validates them (origin only, https), vite.config.ts writes
# them into dist/_headers, the studio frames the partner at VITE_SUPPLIER_ORIGIN and the
# partner shares its tools with VITE_STUDIO_ORIGIN.
#
# Production only: `npm run dev` and the tests leave them unset and use the local dev
# ports from config/origins.js. A build with either one missing or malformed FAILS — it
# would otherwise ship headers naming no partner and an iframe pointing nowhere.
#
# These are public URLs, not secrets — committed so `npm run build` is reproducible.

VITE_STUDIO_ORIGIN=https://alza-dev.pages.dev
VITE_SUPPLIER_ORIGIN=https://alza-dev.netlify.app
