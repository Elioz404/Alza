{
  "name": "alza",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Floor-plan studio for the WebMCP Challenge. Draw in 2D, walk it in 3D, and let an AI agent co-edit the same live page through WebMCP tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "partner": "vite --port 5200 --strictPort",
    "serve:local": "node scripts/serve-local.mjs",
    "e2e": "node scripts/e2e-full.mjs",
    "shots": "node scripts/shots.mjs",
    "deploy:studio": "wrangler pages deploy dist --project-name alza-dev --branch main",
    "deploy:partner": "npx netlify deploy --prod --dir dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
