# The two origins, baked in at build time.
#
# They cannot be derived at runtime: the studio and the partner shop are deliberately
# hosted by different providers, which is the whole point of the cross-origin tool
# exchange. vite.config.ts writes them into dist/_headers, and src/mcp/supplier.ts
# reads VITE_SUPPLIER_ORIGIN to find the partner frame.
#
# These are public URLs, not secrets — committed so `npm run build` is reproducible.
# Without them the build still succeeds, but silently ships:
#     Permissions-Policy: tools=(self)
#     Content-Security-Policy: frame-ancestors 'self'
# and the partner iframe is never allowed to publish its tools.

VITE_STUDIO_ORIGIN=https://alza-dev.pages.dev
VITE_SUPPLIER_ORIGIN=https://alza-dev.netlify.app
